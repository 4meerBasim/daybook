# Daybook cloud sync (Supabase) — copy to .env and fill in, then restart Expo.
# Both must be set for sync to activate; if either is missing the app runs
# fully offline and every sync / share action no-ops with a localized notice.
# EXPO_PUBLIC_* vars are inlined at build time by Expo.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Sign-in (Google / Apple) — optional. Leave blank to keep sign-in buttons hidden
# and sync inert. Create OAuth client ids in Google Cloud Console (type "Web" and,
# for native iOS, type "iOS"); add the Web client id as an Authorized Client ID on
# the Supabase Google provider. Apple needs no client id here (configured on the
# Supabase Apple provider and in Xcode / Apple Developer). The iOS client id is
# also used to derive the reversed-id URL scheme at prebuild (see app.config.js).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
