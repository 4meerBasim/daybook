# Daybook cloud sync (Supabase) — copy to .env and fill in, then restart Expo.
# Both must be set for sync to activate; if either is missing the app runs
# fully offline and every sync / share action no-ops with a localized notice.
# EXPO_PUBLIC_* vars are inlined at build time by Expo.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
